# Settings the app is built with (build.yml passes them to xcodebuild).
# The private GitHub repository that corrections are uploaded to and personal models come from.
TRAINING_REPO=nikpendar/keyless-training
# 1 also builds AvakEmbedded.ipa, the app with the speech model inside (about 110 MB).
BUILD_EMBEDDED=0
# 1 also builds AvakWatch.ipa, the app with the Apple Watch app inside. Watch apps install
# only with a paid developer account (TestFlight/Xcode), not with AltServer and a free Apple ID.
BUILD_WATCH=1
